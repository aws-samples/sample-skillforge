        </mxCell>
        <mxCell id="author-analyst" value="&lt;b&gt;Data analyst&lt;/b&gt;&lt;br&gt;persona + PCI DSS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeColor=#3578E5;fillColor=#FFFFFF;fontColor=#172B4D;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1">
