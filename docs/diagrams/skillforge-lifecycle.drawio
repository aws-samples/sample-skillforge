<mxfile host="app.diagrams.net">
  <diagram id="skillforge-lifecycle" name="Skillforge lifecycle">
    <mxGraphModel dx="1400" dy="1550" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="1550" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Skillforge — one canonical library, tested packs for every harness" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#172B4D;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="35" width="1180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Personas swap. Verticals add. Every generated artefact is validated before installation." style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#52647A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="80" width="1100" height="30" as="geometry" />
        </mxCell>

        <mxCell id="authors-group" value="1  CONTRIBUTORS DEFINE INTENT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeColor=#C7D7FE;fillColor=#F8FAFF;fontColor=#2459B3;fontStyle=1;fontSize=15;verticalAlign=top;align=left;spacingTop=16;spacingLeft=20;" vertex="1" parent="1">
